<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body class="bg-paper text-ink antialiased">
    <%= render "layouts/masthead" %>

    <main class="mx-auto w-full max-w-3xl px-5 pt-10 pb-24 sm:px-8 lg:pt-16">
      <article>
        <header class="flex flex-col gap-5 border-b border-ink/10 pb-10">
          <p class="font-mono text-sm text-riso-deep">
            <time datetime="<%= current_page.data["date"] %>"><%= Date.parse(current_page.data["date"].to_s).strftime("%B %-d, %Y") %></time>
          </p>
          <h1 class="text-section"><%= current_page.data["title"] %></h1>
          <% if current_page.data["description"] %>
            <p class="max-w-[60ch] text-lg leading-relaxed text-ink-muted text-pretty"><%= current_page.data["description"] %></p>
          <% end %>
        </header>

        <div class="prose prose-neutral pt-10 text-pretty">
          <%= yield %>
        </div>
      </article>

      <footer class="mt-20 flex flex-wrap items-baseline justify-between gap-4 border-t border-ink/10 pt-6 font-mono text-xs text-ink-muted">
        <a href="/blog" class="underline decoration-[1.5px] underline-offset-4 hover:text-riso-deep">&larr; all posts</a>
        <a href="https://github.com/thecodingend/rails-starter" aria-label="GitHub repository, 5 stars" class="underline decoration-[1.5px] underline-offset-4 hover:text-riso-deep">github <span class="text-riso-deep" aria-hidden="true">★</span> 5</a>
      </footer>
    </main>
  </body>
</html>
